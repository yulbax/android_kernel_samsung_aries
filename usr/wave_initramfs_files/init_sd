#!/stage1/busybox sh
echo "OHAI, stage1 init (SD) starting" > /dev/kmsg
export _PATH="$PATH"
export PATH=/stage1

sd_host=/sys/devices/platform/s3c-sdhci.2/mmc_host/mmc2

busybox cd /
busybox date >>boot.txt
exec >>boot.txt 2>&1
busybox rm init
busybox mount -t proc proc /proc
busybox mount -t sysfs sysfs /sys

echo "cmdline: $(busybox cat /proc/cmdline)"

mknod_dev() {
	local dev=$(busybox cat $1/dev)
	busybox mknod $2 b ${dev%%:*} ${dev##*:}
}

has_boot_img() {
	local found=1
	busybox test -e /sys/block/$1/${1}p1/dev || return 1
	mknod_dev /sys/block/$1/${1}p1 /dev/block/probe_p1
	busybox mkdir -p /probe
	if busybox mount -t vfat -o ro /dev/block/probe_p1 /probe ; then
		busybox test -f /probe/boot.img && found=0
		busybox umount /probe
	fi
	busybox rm -f /dev/block/probe_p1
	busybox rmdir /probe
	return $found
}

sd_disk=""
tries=0
while busybox test -z "$sd_disk" ; do
	for b in $sd_host/mmc2:*/block/* ; do
		busybox test -e "$b/dev" && sd_disk=$(busybox basename "$b")
	done
	if busybox test -z "$sd_disk" -a $tries -ge 15 ; then
		for b in /sys/block/mmcblk* ; do
			disk=$(busybox basename $b)
			busybox readlink -f $b | busybox grep -q s3c-sdhci.0 && continue
			has_boot_img $disk && sd_disk=$disk && echo "found the card by its boot.img"
		done
	fi
	if busybox test -z "$sd_disk" ; then
		if busybox test $tries = 15 ; then
			echo "no card under $sd_host, block devices:"
			for b in /sys/block/* ; do echo "  $b -> $(busybox readlink -f $b)" ; done
			busybox ls -R /sys/devices/platform/s3c-sdhci.2 | busybox head -n 40
		fi
		echo "Waiting for the SD card..." > /dev/kmsg
		tries=$((tries + 1))
		busybox sleep 1
	fi
done
echo "SD card is $sd_disk after $tries s"

sd_part() {
	mknod_dev /sys/block/$sd_disk/${sd_disk}p$1 /dev/block/sd_p$1
}

save_log() {
	echo "--- $1"
	busybox mkdir -p /sd_boot
	if busybox mount -t vfat /dev/block/sd_p1 /sd_boot ; then
		busybox cp boot.txt /sd_boot/wave_sd.log
		busybox umount /sd_boot
	fi
	busybox rmdir /sd_boot
}

conf_get() {
	busybox sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([0-9][0-9]*\)[[:space:]]*\$/\1/p" /wave_sd.conf | busybox tail -n 1
}

part_cache=2
part_system=3
part_data=4
part_storage=0

sd_part 1
save_log "card found"
busybox mkdir /sd_boot
if busybox mount -t vfat -o ro /dev/block/sd_p1 /sd_boot ; then
	if busybox test -f /sd_boot/wave_sd.conf ; then
		busybox tr -d '\r' < /sd_boot/wave_sd.conf > /wave_sd.conf
	fi
	busybox umount /sd_boot
fi
busybox rmdir /sd_boot
if busybox test -f /wave_sd.conf ; then
	for key in cache system data storage ; do
		value=$(conf_get $key)
		busybox test -n "$value" && eval part_$key=$value
	done
	busybox rm /wave_sd.conf
fi
if busybox test "$part_storage" = 1 ; then
	echo "storage=1 is the boot.img partition, it is /boot only, no storage" > /dev/kmsg
	part_storage=0
fi
echo "SD partitions: cache $part_cache, system $part_system, data $part_data, storage $part_storage" > /dev/kmsg

sd_part $part_cache
sd_part $part_system

save_log "mounting system and cache"
busybox mount -t ext4 /dev/block/sd_p$part_system /system
busybox mount -t ext4 /dev/block/sd_p$part_cache /cache

image=/stage1/ramdisk.cpio

if busybox test -e /cache/.startrecovery ||
    busybox grep -q recovery /proc/cmdline ||
	busybox grep -q bootmode=2 /proc/cmdline || # normal mode
	busybox grep -q bootmode=5 /proc/cmdline || # big mem
	busybox grep -q bootmode=9 /proc/cmdline; then # no cam

	# recovery boot
	busybox rm -fr /cache/.startrecovery
	image=/stage1/ramdisk-recovery.cpio

	# disable lpm
	busybox echo 0 > /sys/class/power_supply/battery/charging_mode_booting
elif ! busybox test -e /system/build.prop; then
	busybox mkdir -p /cache/recovery

	image=/stage1/ramdisk-recovery.cpio

	# disable lpm
	busybox echo 0 > /sys/class/power_supply/battery/charging_mode_booting
fi

echo "image: $image"
busybox grep -E " /(system|cache) " /proc/mounts
busybox ls /sys/block/$sd_disk

busybox umount /cache
busybox umount /system

busybox cpio -i < $image

for f in /fstab.wave /fstab.wave2 /etc/recovery.fstab /etc/twrp.fstab /init.wave.storage.rc ; do
	busybox test -f $f || continue
	busybox sed -i \
		-e "s|/dev/block/wave_sd_cache|/dev/block/${sd_disk}p$part_cache|g" \
		-e "s|/dev/block/wave_sd_system|/dev/block/${sd_disk}p$part_system|g" \
		-e "s|/dev/block/wave_sd_data|/dev/block/${sd_disk}p$part_data|g" \
		$f
	busybox sed -i -e "s|/dev/block/wave_sd_boot|/dev/block/${sd_disk}p1|g" $f
	if busybox test "$part_storage" = 0 ; then
		busybox sed -i -e "/wave_sd_storage/d" $f
	else
		busybox sed -i \
			-e "s|/dev/block/wave_sd_storage|/dev/block/${sd_disk}p$part_storage|g" \
			-e "s|sdcard1:wave_sd_storage|sdcard1:$part_storage|g" \
			$f
	fi
done

busybox date >>boot.txt
save_log "starting $image"

busybox umount /sys
busybox umount /proc
echo "stage1 log:" > /dev/kmsg
busybox cat boot.txt > /dev/kmsg
busybox rm -fr /stage1 /dev/*
export PATH="${_PATH}"
exec /init
